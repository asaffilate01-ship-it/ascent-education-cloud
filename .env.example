VITE_SUPABASE_PROJECT_ID=your-project-id
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
VITE_SUPABASE_URL=https://your-project.supabase.co

# Keep off until the Edge function, Turnstile and durable quota pass hosted acceptance.
VITE_UNIPATHWAY_SECURE_CONTACT_ENABLED=false

# Facilities record commands require the physical and register read switches, hosted write gate and acceptance.
VITE_UNIPATHWAY_FACILITIES_WRITES_ENABLED=false

# Public WhatsApp number in international format (see docs/public-contact-links.md).
VITE_PUBLIC_WHATSAPP_NUMBER=+92 XXX XXX XXXX

# Reviewed optional client switches; keep disabled until hosted acceptance.
VITE_UNIPATHWAY_STUDENT_PLANS_ENABLED=false
VITE_UNIPATHWAY_PHYSICAL_SECURITY_ENABLED=false
VITE_UNIPATHWAY_PHYSICAL_VISITOR_WRITES_ENABLED=false
VITE_UNIPATHWAY_FACILITIES_REGISTER_ENABLED=false
VITE_UNIPATHWAY_TECH_LAB_ENTITLEMENTS_ENABLED=false
VITE_UNIPATHWAY_PRIVATE_MESSAGING_ENABLED=false
VITE_UNIPATHWAY_CLASS_RELEASE_ENABLED=false
VITE_UNIPATHWAY_OFFICE_ACCESS_ENABLED=false
VITE_UNIPATHWAY_STAFF_INVITES_ENABLED=false

# Public challenge site key (not the server secret).
VITE_TURNSTILE_SITE_KEY=

# Activate only after account approval, auth hook, MFA and hosted access acceptance.
VITE_UNIPATHWAY_INSTITUTIONAL_AUTH_ENABLED=false
